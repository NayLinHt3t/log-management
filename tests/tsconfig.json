{
  // Editor and type-check settings for the tests. They run with Vitest and are never
  // compiled; "logmgmt-source" resolves @logs/core to its TypeScript source (no build needed).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "customConditions": ["logmgmt-source"]
  },
  "include": ["**/*.ts"]
}
