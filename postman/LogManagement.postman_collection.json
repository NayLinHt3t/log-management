{
  "info": {
    "_postman_id": "85010d0c-8cb3-5b9d-add8-7a523b647cc0",
    "name": "Log Management API",
    "description": "Ingest, search, dashboard, alert and admin endpoints.\n\n1. Set the collection variables baseUrl, ingestKey and the passwords (from `./run.sh info`).\n2. Run **Auth > Login (admin)** and **Login (viewerA)**: the tokens are saved automatically.\n3. With the appliance's self-signed certificate, turn off *Settings > SSL certificate verification* in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost"
    },
    {
      "key": "ingestKey",
      "value": "paste INGEST_API_KEY from .env"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "paste ADMIN_PASSWORD from .env"
    },
    {
      "key": "viewerPassword",
      "value": "paste VIEWER_PASSWORD from .env"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "viewerToken",
      "value": ""
    },
    {
      "key": "alertId",
      "value": "1"
    },
    {
      "key": "ruleId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Returns a JWT (8 h). The tenant claim decides what the user can see.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (viewerA, tenant demoA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"viewerA\",\n  \"password\": \"{{viewerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('viewerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Ingest",
      "item": [
        {
          "name": "Single event (assignment sample 4.3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ingestKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingest"
              ]
            },
            "description": "X-API-Key authenticates the sender. Events older than the retention window are stored with the arrival time and tagged ts_restamped.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant\": \"demoA\",\n  \"source\": \"api\",\n  \"event_type\": \"app_login_failed\",\n  \"user\": \"alice\",\n  \"ip\": \"203.0.113.7\",\n  \"reason\": \"wrong_password\",\n  \"@timestamp\": \"2025-08-20T07:20:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.expect(pm.response.json().accepted).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Batch: all assignment samples (4.3 - 4.7)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ingestKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingest"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"tenant\": \"demoA\",\n    \"source\": \"api\",\n    \"event_type\": \"app_login_failed\",\n    \"user\": \"alice\",\n    \"ip\": \"203.0.113.7\",\n    \"reason\": \"wrong_password\",\n    \"@timestamp\": \"2025-08-20T07:20:00Z\"\n  },\n  {\n    \"tenant\": \"demoA\",\n    \"source\": \"crowdstrike\",\n    \"event_type\": \"malware_detected\",\n    \"host\": \"WIN10-01\",\n    \"process\": \"powershell.exe\",\n    \"severity\": 8,\n    \"sha256\": \"abc...\",\n    \"action\": \"quarantine\",\n    \"@timestamp\": \"2025-08-20T08:00:00Z\"\n  },\n  {\n    \"tenant\": \"demoB\",\n    \"source\": \"aws\",\n    \"cloud\": {\n      \"service\": \"iam\",\n      \"account_id\": \"123456789012\",\n      \"region\": \"ap-southeast-1\"\n    },\n    \"event_type\": \"CreateUser\",\n    \"user\": \"admin\",\n    \"@timestamp\": \"2025-08-20T09:10:00Z\",\n    \"raw\": {\n      \"eventName\": \"CreateUser\",\n      \"requestParameters\": {\n        \"userName\": \"temp-user\"\n      }\n    }\n  },\n  {\n    \"tenant\": \"demoB\",\n    \"source\": \"m365\",\n    \"event_type\": \"UserLoggedIn\",\n    \"user\": \"bob@demo.local\",\n    \"ip\": \"198.51.100.23\",\n    \"status\": \"Success\",\n    \"workload\": \"Exchange\",\n    \"@timestamp\": \"2025-08-20T10:05:00Z\"\n  },\n  {\n    \"tenant\": \"demoA\",\n    \"source\": \"ad\",\n    \"event_id\": 4625,\n    \"event_type\": \"LogonFailed\",\n    \"user\": \"demo\\\\eve\",\n    \"host\": \"DC01\",\n    \"ip\": \"203.0.113.77\",\n    \"logon_type\": 3,\n    \"@timestamp\": \"2025-08-20T11:11:11Z\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('all accepted', () => pm.expect(pm.response.json().rejected).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Native CloudTrail records (source detected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ingestKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ingest?tenant=demoB",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingest"
              ],
              "query": [
                {
                  "key": "tenant",
                  "value": "demoB"
                }
              ]
            },
            "description": "Records without a tenant use ?tenant=. The source is detected from the record shape (eventSource + eventName = AWS).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Records\": [\n    {\n      \"eventVersion\": \"1.08\",\n      \"userIdentity\": {\n        \"type\": \"IAMUser\",\n        \"principalId\": \"AIDAEXAMPLE1\",\n        \"arn\": \"arn:aws:iam::123456789012:user/admin\",\n        \"accountId\": \"123456789012\",\n        \"userName\": \"admin\"\n      },\n      \"eventTime\": \"2026-10-12T09:10:00Z\",\n      \"eventSource\": \"iam.amazonaws.com\",\n      \"eventName\": \"CreateUser\",\n      \"awsRegion\": \"ap-southeast-1\",\n      \"sourceIPAddress\": \"203.0.113.10\",\n      \"userAgent\": \"aws-cli/2.15.0\",\n      \"requestParameters\": {\n        \"userName\": \"temp-user\"\n      },\n      \"recipientAccountId\": \"123456789012\"\n    },\n    {\n      \"eventVersion\": \"1.08\",\n      \"userIdentity\": {\n        \"type\": \"IAMUser\",\n        \"arn\": \"arn:aws:iam::123456789012:user/admin\",\n        \"accountId\": \"123456789012\",\n        \"userName\": \"admin\"\n      },\n      \"eventTime\": \"2026-10-12T09:11:30Z\",\n      \"eventSource\": \"iam.amazonaws.com\",\n      \"eventName\": \"AttachUserPolicy\",\n      \"awsRegion\": \"ap-southeast-1\",\n      \"sourceIPAddress\": \"203.0.113.10\",\n      \"requestParameters\": {\n        \"userName\": \"temp-user\",\n        \"policyArn\": \"arn:aws:iam::aws:policy/AdministratorAccess\"\n      },\n      \"recipientAccountId\": \"123456789012\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "NDJSON (one JSON object per line)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ingestKey}}"
