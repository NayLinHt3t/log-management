              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "<134>Aug 20 12:44:56 fw01 vendor=demo product=ngfw action=deny src=10.0.1.10 dst=8.8.8.8 spt=5353 dpt=53 proto=udp msg=DNS blocked policy=Block-DNS\n<190>Aug 20 13:01:02 r1 if=ge-0/0/1 event=link-down mac=aa:bb:cc:dd:ee:ff reason=carrier-loss"
            }
          }
        },
        {
          "name": "Upload a file (admin token)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ingest/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingest",
                "file"
              ]
            },
            "description": "multipart/form-data: file (JSON, NDJSON, CloudTrail, CSV or .log), optional tenant and source. Pick the file again in Postman if the path does not resolve.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "tenant",
                  "value": "demoB",
