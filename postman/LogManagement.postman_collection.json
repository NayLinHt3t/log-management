              "raw": "{\"tenant\":\"demoA\",\"source\":\"api\",\"event_type\":\"app_login_success\",\"user\":\"bob\",\"ip\":\"10.0.1.20\"}\n{\"tenant\":\"demoA\",\"source\":\"api\",\"event_type\":\"order_created\",\"user\":\"bob\",\"status_code\":201}"
            }
