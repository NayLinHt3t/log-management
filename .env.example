# Log Management configuration. Copy to .env (./run.sh up does this and fills in secrets).
# Every value containing "change-me" is replaced with a random secret by ./run.sh up.

# ---------------------------------------------------------------- secrets
POSTGRES_USER=logs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logs
# signs login tokens (JWT, HS256); at least 32 characters
JWT_SECRET=change-me
# demo accounts created on first start: admin (all tenants), viewerA (demoA), viewerB (demoB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
VIEWER_PASSWORD=change-me
# global ingest key for POST /api/ingest (header X-API-Key); more keys can be made in the UI
INGEST_API_KEY=change-me

# ---------------------------------------------------------------- deployment
# Appliance: leave SITE_ADDRESS=https:// and TLS_MODE=selfsigned (works for any host name or IP).
# SaaS with a domain: ./run.sh saas with DOMAIN=logs.example.com and TLS_MODE=acme (Let's Encrypt).
SITE_ADDRESS=https://
TLS_MODE=selfsigned
DOMAIN=
# link used in alert notifications (./run.sh fills it in)
PUBLIC_URL=
HTTP_PORT=80
HTTPS_PORT=443
SYSLOG_PORT=514
# local port of the database for psql and `npm run dev` (bound to 127.0.0.1 only)
DB_PORT=5433

# ---------------------------------------------------------------- data
# days of events kept per tenant (minimum 7); whole daily partitions are dropped
RETENTION_DAYS=7
# events older than RETENTION_DAYS: restamp (store with arrival time, tag ts_restamped) or reject
LATE_EVENT_POLICY=restamp
MAX_FUTURE_MINUTES=60
# create the demo tenants, users and alert rules on first start
SEED_DEMO=true

# ---------------------------------------------------------------- syslog
# syslog has no tenant field: unmapped senders go to the default tenant
SYSLOG_DEFAULT_TENANT=demoA
# optional sender mapping, e.g. 10.20.0.0/16=demoB,192.168.1.10=demoA
SYSLOG_TENANT_MAP=
# auto = trust the device clock only for RFC 5424/ISO timestamps; event; receive
SYSLOG_TIMESTAMP=auto

# ---------------------------------------------------------------- alerts
# default webhook for rules without their own, e.g. https://webhook.site/<your-id>
ALERT_WEBHOOK_URL=
ALERT_INTERVAL_SECONDS=15

# ---------------------------------------------------------------- optional
# lets Prometheus scrape /api/metrics with "Authorization: Bearer <token>" (16+ characters)
METRICS_TOKEN=
LOG_LEVEL=info
